"controller_mappings"
{
	"version"		"3"
	"title"		"OpenNeoUA Deck IGA"
	"description"		"OpenNeoUA native Steam Input layout for Steam Deck (Spacewar 480 POC)."
	"controller_type"		"controller_neptune"
	"controller_capacitor"		"1"
	"preset"
	{
		"id"		"0"
		"name"		"Menu"
		group
		{
			"id"		"0"
			"mode"		"four_buttons"
			"bindings"
			{
				"button_a"		"game_action Menu MenuConfirm, Confirm"
				"button_b"		"game_action Menu MenuCancel, Cancel"
				"button_x"		"game_action Menu SwitchWeapon, Switch Weapon"
				"button_y"		"game_action Menu AlternativeView, Alt View"
			}
			"settings"
			{
				"requires_click"		"0"
			}
		}
		group
		{
			"id"		"1"
			"mode"		"dpad"
			"bindings"
			{
				"dpad_north"		"game_action Menu MenuUp, Menu Up"
				"dpad_south"		"game_action Menu MenuDown, Menu Down"
				"dpad_west"		"game_action Menu MenuLeft, Menu Left"
				"dpad_east"		"game_action Menu MenuRight, Menu Right"
			}
			"settings"
			{
				"requires_click"		"0"
				"layout"		"radial_top_down"
			}
		}
		group
		{
			"id"		"2"
			"mode"		"absolute_mouse"
			"bindings"
			{
				"output"		"game_action Menu MenuCursor, Menu Cursor"
			}
			"settings"
			{
				"sensitivity"		"100"
				"trackball"		"0"
				"rotation_offset"		"0"
			}
		}
		group
		{
			"id"		"7"
			"mode"		"switches"
			"bindings"
			{
				"button_escape"		"game_action Menu Map, Map"
				"button_menu"		"game_action Menu Pause, Pause"
				"left_bumper"		"game_action Menu CamFire, Cam Fire"
				"right_bumper"		"game_action Menu CycleTarget, Cycle Target"
				"button_back_left_upper"		"game_action Menu NextUnit, Next Unit"
				"button_back_right_upper"		"game_action Menu ControlUnit, Control Unit"
			}
		}
		"group_source_bindings"
		{
			"0"		"button_diamond active"
			"1"		"left_trackpad inactive"
			"2"		"right_trackpad active"
			"7"		"switch active"
		}
	}
