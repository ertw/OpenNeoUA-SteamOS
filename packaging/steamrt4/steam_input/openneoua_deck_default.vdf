"controller_mappings"
{
	"version"		"3"
	"title"		"OpenNeoUA Deck Default"
	"description"		"OpenNeoUA revision 2 Legacy layout for Steam Deck. Left stick = virtual gamepad. Right stick/trackpad/gyro = mouse. Gyro on right-stick or right-trackpad touch. Enable Joystick in Input Settings."
	"creator"		"0"
	"controller_type"		"controller_neptune"
	"controller_capacitor"		"1"
	"revision"		"2"
