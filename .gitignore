# Original game data, private builds, and local tooling stay untracked.
# Allow only the engine and the resources shipped by this repository.
/*

!/.gitignore
!/README.md
!/STEAM_DECK.md
!/License.txt
!/OpenNeoUA.ini
!/OpenNeoUA_Parameter_Guide_EN.md
!/OpenNeoUA.sh

!/src/
!/svg/
!/Res/
!/Interface/
!/Filters/
!/Collision/
!/Models/
!/Fonts/

!/Wireless/
/Wireless/*
!/Wireless/New/

!/Sounds/
/Sounds/*
!/Sounds/New/
!/Sounds/Speech/
/Sounds/Speech/*
!/Sounds/Speech/Voicepacks/
/Sounds/Speech/Voicepacks/*
!/Sounds/Speech/Voicepacks/UserCreated/

!/Scripts/
/Scripts/*
!/Scripts/Buffs.cfg
!/Scripts/Clouds.cfg
!/Scripts/Debuffs.cfg
!/Scripts/Graphic_Profiles/
!/Scripts/FX_Profiles/
!/Scripts/Ground_Decals.cfg
!/Scripts/Startup.cfg
!/Scripts/SuperItems.cfg
!/Scripts/spectator_vehicle.cfg

!/Levels/
/Levels/*
!/Levels/Bg/
/Levels/Bg/*
!/Levels/Bg/Workshop.png

!/Locale/
/Locale/*
!/Locale/OpenNeoUA.lng

!/Env/
/Env/*
!/Env/menu_font.txt
!/Env/visual_filter.txt
!/Env/visual_filter_strength.txt

!/packaging/
!/packaging/steamrt4/
!/packaging/steamrt4/**
!/.github/
!/.github/workflows/
!/.github/workflows/linux-steamrt4.yml

# Generated files within source/tool directories.
__pycache__/
*.py[cod]
.DS_Store
